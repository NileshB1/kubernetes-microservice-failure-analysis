# ============================================================
# Distributed Analysis of Kubernetes Microservice Logs
# Environment Configuration
# ============================================================

# MinIO (Blob Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=microservice-logs
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# PostgreSQL
POSTGRES_USER=sparkuser
POSTGRES_PASSWORD=sparkpass
POSTGRES_DB=microservice_analysis
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Spark
SPARK_MASTER_HOST=spark-master
SPARK_MASTER_PORT=7077
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# Dataset
DATASET_PATH=/data/microservices-bottleneck-detection-dataset
SAMPLE_DATA_ROWS=1000000
