# ============================================================
# .env.example — Local Development Configuration
# ============================================================
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
#
# The run_streamlit.py launcher reads these values.
# Docker Compose also uses these (with different defaults).
# ============================================================

# PostgreSQL (required)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sparkuser
POSTGRES_PASSWORD=sparkpass
POSTGRES_DB=microservice_analysis

# MinIO (optional — for full pipeline)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=microservice-logs

# Spark (optional — for Spark metrics tab)
SPARK_MASTER_URL=spark://localhost:7077
SPARK_MASTER_HOST=localhost

# Pipeline Settings
SAMPLE_DATA_ROWS=100000
SCALABILITY_DATA_SIZES=100000,500000,1000000
OUTPUT_DIR=./output
LOG_LEVEL=INFO
