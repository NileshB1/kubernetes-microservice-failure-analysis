# ============================================================
# Environment template
# ============================================================
#   cp .env.example .env
# then set the three secrets marked REQUIRED below.
#
# .env is deliberately not tracked by git. Never commit real
# credentials - anything in git history is effectively public.
#
# Hostnames below assume Docker Compose, where services reach each other
# by service name. Running the dashboard directly on your machine
# instead? Use localhost - see the "Local (non-Docker)" block at the end.
# ============================================================

# ---- Application ------------------------------------------
# development | production. Setting production makes startup reject the
# development default credentials and plaintext MinIO endpoints.
APP_ENV=development
LOG_LEVEL=INFO

# postgres | sqlite. sqlite needs no services at all - see README demo mode.
DB_MODE=postgres

# ---- PostgreSQL -------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sparkuser
# REQUIRED - no default. Generate one: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=microservice_analysis

# ---- MinIO (blob storage) ---------------------------------
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=microservice-logs
MINIO_ACCESS_KEY=minioadmin
# REQUIRED - no default. Generate one: openssl rand -base64 24
MINIO_SECRET_KEY=

# ---- Spark ------------------------------------------------
SPARK_MASTER_HOST=spark-master
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_REPLICAS=4
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# ---- Pipeline ---------------------------------------------
SAMPLE_DATA_ROWS=1000000
SCALABILITY_DATA_SIZES=1000000,5000000,10000000
DATASET_PATH=/data/microservices-bottleneck-detection-dataset
OUTPUT_DIR=/output

# ---- Dashboard --------------------------------------------
# Interface the dashboard port binds to. 127.0.0.1 keeps it on this
# machine; use 0.0.0.0 only behind an authenticating reverse proxy.
DASHBOARD_BIND=127.0.0.1

# ============================================================
# Local (non-Docker) overrides
# ============================================================
# Running `python run_streamlit.py` on your own machine? The service
# names above will not resolve. Replace them with:
#   POSTGRES_HOST=localhost
#   MINIO_ENDPOINT=http://localhost:9000
#   SPARK_MASTER_HOST=localhost
#   SPARK_MASTER_URL=spark://localhost:7077
#   OUTPUT_DIR=./output
# Or skip all of it and use the zero-dependency demo:
#   python run_streamlit.py --local --browser
